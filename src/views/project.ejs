<%- include('partials/header') %>

  <main>
    <h1>
      <%= title %>
    </h1>

    <% if (project) { %>

      <h2>
        <%= project.title %>
      </h2>

      <p>
        <strong>Description:</strong>
        <%= project.description %>
      </p>

      <p>
        <strong>Date:</strong>
        <%= project.project_date %>
      </p>

      <p>
        <strong>Location:</strong>
        <%= project.location %>
      </p>

      <p>
        <strong>Partner Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
          <%= project.organization_name %>
        </a>
      </p>

      <!-- Volunteer Functionality -->
      <% if (user) { %>

        <% if (userIsVolunteer) { %>

          <p>
            <strong>You are volunteering for this project.</strong>
          </p>

          <p>
            <a href="/project/<%= project.project_id %>/remove-volunteer">
              Remove Me as Volunteer
            </a>
          </p>

          <% } else { %>

            <p>
              <a href="/project/<%= project.project_id %>/volunteer">
                Volunteer for This Project
              </a>
            </p>

            <% } %>

              <% } %>

                <% if (user && user.role_name==='admin' ) { %>

                  <p>
                    <a href="/edit-project/<%= project.project_id %>">
                      Edit Project
                    </a>
                  </p>

                  <p>
                    <a href="/assign-categories/<%= project.project_id %>">
                      Edit Categories
                    </a>
                  </p>

                  <% } %>

                    <section class="project-categories">
                      <h3>Categories</h3>

                      <% if (categories && categories.length> 0) { %>

                        <ul>
                          <% categories.forEach(category=> { %>
                            <li>
                              <a href="/category/<%= category.category_id %>">
                                <%= category.name %>
                              </a>
                            </li>
                            <% }) %>
                        </ul>

                        <% } else { %>

                          <p>No categories listed for this project.</p>

                          <% } %>
                    </section>

                    <% } else { %>

                      <p>Project not found.</p>

                      <% } %>

  </main>

  <%- include('partials/footer') %>