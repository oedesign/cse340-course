<%- include('partials/header') %>

  <main>
    <h1>
      <%= title %>
    </h1>

    <h2>Dashboard</h2>

    <p>
      Name: <%= name %>
    </p>

    <p>
      Email: <%= email %>
    </p>

    <% if (user && user.role_name==='admin' ) { %>
      <p>
        <a href="/users">
          View Registered Users
        </a>
      </p>
      <% } %>

        <section class="volunteer-projects">
          <h2>My Volunteer Projects</h2>

          <% if (volunteerProjects && volunteerProjects.length> 0) { %>

            <ul>
              <% volunteerProjects.forEach(project=> { %>

                <li>
                  <a href="/project/<%= project.project_id %>">
                    <%= project.title %>
                  </a>

                  <!-- (<%= project.project_date %>) -->
                  (<%= project.date %>)

                    <a href="/project/<%= project.project_id %>/remove-volunteer">
                      Remove Volunteer Status
                    </a>
                </li>

                <% }) %>
            </ul>

            <% } else { %>

              <p>
                You have not signed up to volunteer for any projects yet.
              </p>

              <% } %>
        </section>

  </main>

  <%- include('partials/footer') %>